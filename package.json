{
  "name": "@gpujs/expo-gl-example",
  "version": "2.0.0",
  "description": "A GPU.js native example used with https://github.com/gpujs/expo-gl",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export --platform ios --output-dir /tmp/expo-gl-example-bundle"
  },
  "dependencies": {
    "@gpujs/expo-gl": "^1.0.0",
    "expo": "~58.0.22",
    "expo-gl": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "gpu.js": "^2.19.9",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "node-gyp": "^11.5.0",
    "minimatch@^9.0.0": "^11.0.4",
    "minimatch@^10.0.0": "^11.0.4",
    "glob@^10.0.0": "^14.0.3",
    "glob@^13.0.0": "^14.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpujs/expo-gl-example.git"
  },
  "license": "MIT"
}
